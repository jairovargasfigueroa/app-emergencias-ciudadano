# Copiar como .env.local (no se versiona) y completar.

# URL del backend vista desde el teléfono: la IP de tu computadora en la red, no "localhost".
EXPO_PUBLIC_API_URL=http://192.168.0.10:8080

# Firebase Realtime Database (configuración de la app web del proyecto de Firebase).
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_DATABASE_URL=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# Segundos sin recibir la posición de una unidad para mostrar "última actualización hace X" (PB-06 R3).
EXPO_PUBLIC_UMBRAL_POSICION_SEG=60

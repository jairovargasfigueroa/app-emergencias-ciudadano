{
  "expo": {
    "name": "SGA Ciudadano",
    "slug": "ambulancias-app-ciudadano",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ambulanciasappciudadano",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "versionCode": 2,
      "package": "com.uem.ambulancias.ciudadano",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#D92D20",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SGA Ciudadano envía tu ubicación con la alerta para que la ambulancia llegue a ti."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#D92D20",
          "defaultChannel": "avisos"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SGA Ciudadano usa tus fotos solo si eliges una para mostrar a la ambulancia lo que pasa.",
          "cameraPermission": "SGA Ciudadano usa la cámara para que tomes una foto o un video de la emergencia.",
          "microphonePermission": "SGA Ciudadano usa el micrófono para grabar el sonido del video de la emergencia."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SGA Ciudadano usa el micrófono para que grabes un audio contando lo que pasa.",
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
